{
  "name": "mcp-human-approval-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public-safe research prototype for deterministic policy and human approval of MCP tool actions.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:demo": "VITE_STATIC_DEMO=true vite build",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test",
    "check": "npm run build && npm run build:demo && npm test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^6.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {}
}
