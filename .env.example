PORT=4174
DATABASE_PATH=./data/gateway.db

# Optional OpenAI-compatible model endpoint. If omitted, the gateway uses a
# deterministic offline analyst so the demo remains reproducible and safe.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional. Signs every audit event with an HMAC so someone who can write the
# database but does not hold this key cannot rebuild the chain. Set it before the
# first event is written; an existing unsigned database will fail verification.
AUDIT_HMAC_KEY=

# Set to false to remove the unauthenticated /api/reset route.
ALLOW_RESET=true

# Bind address. Loopback by default. Containers and hosts set HOST=0.0.0.0.
HOST=127.0.0.1

# MCP server (POST /mcp and `npm run mcp:stdio`). Unauthenticated demo mode.
# MCP_AGENT_ID is the identity every MCP caller is recorded under.
# MCP_HTTP defaults to true on loopback and false elsewhere.
# MCP_ALLOWED_HOSTS and MCP_ALLOWED_ORIGINS are comma separated lists for use behind a proxy.
MCP_AGENT_ID=mcp-agent-demo
MCP_HTTP=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
