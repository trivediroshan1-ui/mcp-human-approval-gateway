PORT=4174
DATABASE_PATH=./data/gateway.db

# Optional OpenAI-compatible model endpoint. If omitted, the gateway uses a
# deterministic offline analyst so the demo remains reproducible and safe.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional. Signs every audit event with an HMAC so someone who can write the
# database but does not hold this key cannot rebuild the chain. Set it before the
# first event is written; an existing unsigned database will fail verification.
AUDIT_HMAC_KEY=

# Set to false to remove the unauthenticated /api/reset route.
ALLOW_RESET=true
